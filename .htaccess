# JobConnct root .htaccess
# - Disable directory listing
# - Block direct access to config.php and functions.php

Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(config|functions)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(config|functions)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
